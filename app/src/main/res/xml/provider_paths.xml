<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider 只开放实际会被分享的两类文件：日志(Logs/)与更新安装包(Updates/)。
    原先还挂了 cache-path / files-path / external-path / external-cache-path 的 path="."
    兜底项，等于把应用私有目录、缓存乃至整块外部存储都纳入可授权范围——外部应用拿到
    临时 URI 后即可读取这些目录下的任意文件。
    对应代码：ShareUtils.getUriFromFile()，调用方为日志分享与 APK 安装跳转。
-->
<paths>
    <!-- external-files-path 表示 context.getExternalFilesDir() 下的路径 -->
    <external-files-path name="Logs" path="Logs/" />
    <external-files-path name="Updates" path="Updates/" />
</paths>
