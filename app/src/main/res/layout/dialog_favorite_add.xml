<?xml version="1.0" encoding="utf-8"?>
<!-- 手动添加收藏对话框（FavoriteActivity 弹出），经纬度输入与坐标系选择沿用 location_input 的控件约定 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical">

    <EditText
            android:id="@+id/favorite_add_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:autofillHints="name"
            android:hint="@string/favorite_add_name_hint"
            android:inputType="text"
            android:minHeight="48dp"/>

    <EditText
            android:id="@+id/favorite_add_longitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:autofillHints="longitude"
            android:hint="@string/label_longitude"
            android:inputType="numberDecimal"
            android:digits="-0123456789."
            android:minHeight="48dp"/>

    <EditText
            android:id="@+id/favorite_add_latitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:autofillHints="latitude"
            android:hint="@string/label_latitude"
            android:inputType="numberDecimal"
            android:digits="-0123456789."
            android:minHeight="48dp"/>

    <RadioGroup
            android:id="@+id/favorite_add_coord_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal">

        <RadioButton
                android:id="@+id/favorite_add_gcj"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/input_position_gcj"/>

        <RadioButton
                android:id="@+id/favorite_add_wgs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/input_position_gps"/>
    </RadioGroup>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:orientation="horizontal">

        <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

        <Button
                android:id="@+id/favorite_add_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/input_position_cancel"/>

        <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

        <Button
                android:id="@+id/favorite_add_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/favorite_add_save"/>

        <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

    </LinearLayout>
</LinearLayout>
